# Copy to docker/.env (gitignored). Read by compose for ${...} values and
# passed to every container. Secrets are never here: they are files in
# SECRETS_DIR, mounted by compose `secrets:`.
SECRETS_DIR=/home/nova/secrets
# The Traefik router's host; APP_URL must be the same origin.
APP_HOST=reservations.example
APP_URL=https://reservations.example
# Never named anywhere public (robots.txt, sitemap, learner pages).
ADMIN_ENTRY_PATH=/l0gin
AUTHENTIK_URL=https://authentik.example
AUTHENTIK_CLIENT_ID=
# Production needs a real Turnstile widget for APP_HOST. These are
# Cloudflare's "always passes" test keys: no bot protection.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
APP_ENCRYPTION_ACTIVE_KEY_ID=
# ADMIN_SESSION_HOURS=2
# LEARNER_SESSION_HOURS=8
