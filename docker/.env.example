# Copy to docker/.env (gitignored). Optional for the database alone: `npm run
# db:up` works without it. Read by compose for ${...} values and passed to
# every container. Secrets are never here: they are files in
# SECRETS_DIR, mounted by compose `secrets:`.
# Default (if unset): .secrets/ in the repo root. db:up makes postgres_password
# and hol_app_password here when missing.
SECRETS_DIR=/home/nova/secrets
# Host side of the database port, only if 5432 is taken (a second clone).
# DB_HOST_PORT=5432
# The Traefik router's host; APP_URL must be the same origin.
APP_HOST=reservations.example
APP_URL=https://reservations.example
# Never named anywhere public (robots.txt, sitemap, learner pages).
ADMIN_ENTRY_PATH=/l0gin
AUTHENTIK_URL=https://authentik.example
AUTHENTIK_CLIENT_ID=
# A public deployment needs a real Turnstile widget for APP_HOST. These are
# Cloudflare's "always passes" test keys: no bot protection.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
APP_ENCRYPTION_ACTIVE_KEY_ID=
# ADMIN_SESSION_HOURS=2
# LEARNER_SESSION_HOURS=8
# How many Nile Portal resets the worker runs at once, 1 to 5 (spec 0023).
# PORTAL_RESET_LANES=2
