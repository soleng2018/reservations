# Copy to .env.local for `npm run dev`. Never commit real values.
# `npm run db:up` starts the Postgres container; dev reaches it on the host loopback.
# If DB_HOST_PORT is set for the container, DATABASE_PORT must match it.
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=reservations
DATABASE_USER=hol_app
# The hol_app_password file that `npm run db:up` made (SECRETS_DIR, else .secrets/ in the repo).
DATABASE_PASSWORD_FILE=/path/to/hol_app_password
TZ=UTC
# Auth (spec 0003). The client id and secret come from `npm run authentik:setup`.
# Must match the URL the browser uses, or sign in fails with state_mismatch.
# The Authentik proxy refuses requests that mention localhost, so dev uses the
# LAN IP (for example http://10.1.255.18:3000).
APP_URL=http://localhost:3000
ADMIN_ENTRY_PATH=/l0gin
AUTHENTIK_URL=https://authentik.example
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET_FILE=/path/to/authentik_client_secret
# At least 32 characters.
AUTH_SECRET_FILE=/path/to/auth_secret
# The RBAC limited token for the provisioning service account the setup
# script prints. Never the master token.
AUTHENTIK_PROVISIONING_TOKEN_FILE=/path/to/authentik_provisioning_token
# Cloudflare Turnstile. These are Cloudflare's public "always passes" test keys.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Spec 0006. The keyring that encrypts stored API key secrets, from
# `npm run secrets:keygen` (mode 600, backed up). The web, worker, and dev
# server all read this one file. Without it only the API Keys page is off.
# The worker needs it too (spec 0012): it decrypts the Cloudflare API key, and
# without the keyring a stored Cloudflare key turns the VM revoke "broken".
APP_ENCRYPTION_KEYS_FILE=/path/to/hol_encryption_keys.json
APP_ENCRYPTION_ACTIVE_KEY_ID=
# Spec 0004. True only where every request comes through the Cloudflare
# Tunnel, so CF-Connecting-IP can be trusted for rate limits.
TRUST_PROXY_HEADERS=false
# `npm run worker` exits unless this is true. Authentik is shared, so a worker
# started here reconciles the real groups (only one worker runs at a time).
WORKER_ENABLED=false
# ADMIN_SESSION_HOURS=2
# LEARNER_SESSION_HOURS=8
