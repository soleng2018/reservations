# Copy to .env.local for `npm run dev`. Never commit real values.
# Local dev reaches InsForge's Postgres on the host loopback.
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=insforge
DATABASE_USER=hol_app
# Prefer a secret file; DATABASE_PASSWORD also works in dev.
DATABASE_PASSWORD_FILE=/path/to/hol_app_password
TZ=UTC
