{
  "name": "reservations",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:bundle": "tsx scripts/bundle.ts",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:migrate": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/migrate.ts",
    "db:codegen": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/codegen.ts",
    "calendar:backfill": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/calendar-backfill.ts",
    "worker": "tsx --import ./worker/server-only-hook.mjs --env-file-if-exists=.env.local worker/index.ts",
    "prepare": "husky",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "authentik:setup": "tsx scripts/authentik-setup.ts",
    "secrets:keygen": "tsx --conditions=react-server scripts/secrets-keygen.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@goauthentik/api": "2026.2.1",
    "better-auth": "1.7.12",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "google-auth-library": "11.1.0",
    "ical-generator": "11.1.2",
    "kysely": "^0.29.7",
    "lucide-react": "^1.53.0",
    "next": "16.4.3",
    "nodemailer": "10.2.1",
    "pg": "^8.23.1",
    "react": "19.2.8",
    "react-day-picker": "9.14.0",
    "react-dom": "19.2.8",
    "react-email": "6.11.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.4",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.1",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "kysely-codegen": "^0.20.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24"
  }
}
